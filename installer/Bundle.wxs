<?xml version="1.0" encoding="UTF-8"?>
<!--
  GUI Setup.exe (WiX Burn + WixStdBA) — khong phai console.
  Chain: WebView2 Standalone (pin) roi MeiliPilot.msi.
  DetectCondition: may >= pin thi skip (khong ha cap). Thieu/cu hon thi cai khi bam Install.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
    Name="MeiliPilot"
    Manufacturer="MeiliPilot"
    Version="0.1.0"
    UpgradeCode="C9E2A14D-8B7F-4E31-91A6-2D5C8F0B4E77"
    IconSourceFile="!(bindpath.Res)\icon.ico"
    Copyright="Copyright 2026 sangnx6297@gmail.com"
    AboutUrl="mailto:sangnx6297@gmail.com"
    DisableModify="button">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        LicenseFile="license.rtf"
        Theme="rtfLicense"
        SuppressOptionsUI="yes"
        ShowVersion="yes"
        LaunchTarget="[ProgramFiles64Folder]MeiliPilot\MeiliPilot.exe" />
    </BootstrapperApplication>

    <Variable Name="Wv2Min" Type="version" Value="$(var.WebView2Pin)" />

    <util:RegistrySearch
      Id="Wv2LM32"
      Root="HKLM"
      Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
      Value="pv"
      Variable="Wv2LM32"
      Result="value"
      Bitness="always32" />
    <util:RegistrySearch
      Id="Wv2LM64"
      After="Wv2LM32"
      Root="HKLM"
      Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
      Value="pv"
      Variable="Wv2LM64"
      Result="value"
      Bitness="always64" />
    <util:RegistrySearch
      Id="Wv2CU"
      After="Wv2LM64"
      Root="HKCU"
      Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
      Value="pv"
      Variable="Wv2CU"
      Result="value"
      Bitness="always32" />

    <Chain>
      <ExePackage
        Id="WebView2"
        DisplayName="Microsoft Edge WebView2 Runtime"
        SourceFile="!(bindpath.Payload)\MicrosoftEdgeWebView2RuntimeInstallerX64.exe"
        Compressed="yes"
        Permanent="yes"
        Vital="yes"
        DetectCondition="Wv2LM32 &gt;= Wv2Min OR Wv2LM64 &gt;= Wv2Min OR Wv2CU &gt;= Wv2Min"
        InstallArguments="/silent /install"
        Protocol="none" />
      <MsiPackage
        Id="MeiliPilot"
        SourceFile="!(bindpath.Bin)\MeiliPilot.msi"
        Compressed="yes"
        Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
